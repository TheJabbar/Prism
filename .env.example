# PRISM Configuration
# Copy to .env and fill in your keys

# LLM API Keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
GROQ_API_KEY=gsk_your-groq-key-here

# LLM Provider: "openrouter" or "groq"
LLM_PROVIDER=openrouter
LLM_MODEL=openrouter:anthropic/claude-sonnet-4

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/prism.db

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-random-secret

# Timezone
TZ=Asia/Jakarta
